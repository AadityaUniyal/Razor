# RazorRescue Environment Template
# Copy this file to .env for local development. Never commit real credentials or secrets to git.

# Database (PostgreSQL / Neon, or leave empty for local SQLite fallback)
DATABASE_URL=

# Core Application Security
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:8000
ENVIRONMENT=development

# LLM Providers (Optional - falls back to deterministic heuristic recovery policy)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Razorpay Payment Gateway (Optional - supports free test keys rzp_test_... or deterministic simulation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Ingestion & Authentication
INGEST_API_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Outbound Dispatch Engine (Optional - free Gmail, Brevo, or Mailtrap SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@razorrescue.local
WHATSAPP_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
